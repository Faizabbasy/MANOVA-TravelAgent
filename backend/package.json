{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun test",
    "db:migrate": "bun scripts/db.ts migrate",
    "db:rollback": "bun scripts/db.ts rollback",
    "db:status": "bun scripts/db.ts status",
    "db:seed:demo": "bun scripts/db.ts seed:demo",
    "db:backup": "bun scripts/db.ts backup",
    "db:restore": "bun scripts/db.ts restore",
    "db:rehearse": "bun scripts/db.ts rehearse",
    "seed:extract": "bun scripts/extract-demo-core.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "~5.9.3"
  }
}
