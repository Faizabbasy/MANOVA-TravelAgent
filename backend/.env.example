# development | test | production
APP_ENV=development
PORT=3000

# postgres://user:pass@host:5432/db for a PostgreSQL server (required in production).
# pglite://.data/pglite = embedded PostgreSQL (WASM) in a local folder — zero-setup local dev (default).
# pglite://memory      = throwaway in-memory database (tests).
DATABASE_URL=pglite://.data/pglite

# Browser origins allowed to call the API with credentials (comma-separated, no trailing slash).
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

SESSION_TTL_HOURS=12
# Defaults to true in production and cannot be disabled there.
COOKIE_SECURE=false
# true when the API is reachable ONLY through the Nuxt /api/v1 proxy (which overwrites X-Forwarded-For);
# the rightmost hop is then used for login throttling and audit. Never enable on a publicly reachable API.
TRUST_PROXY=false

# Password for every demo login created by `bun run db:seed:demo` (never used in production).
DEMO_PASSWORD=manova-demo

# Directory with pg_dump / pg_restore when they are not on PATH (db:backup / db:restore on Postgres).
# PG_BIN=C:/Program Files/PostgreSQL/17/bin
