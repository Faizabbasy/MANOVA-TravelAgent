{
  "name": "manova-travelagent",
  "private": true,
  "scripts": {
    "install:all": "pnpm --dir frontend install && (cd backend && bun install)",
    "dev": "pnpm --dir frontend dev & (cd backend && bun run dev) & wait",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "cd backend && bun run dev",
    "build:frontend": "pnpm --dir frontend build",
    "lint": "pnpm --dir frontend lint",
    "typecheck": "pnpm --dir frontend typecheck",
    "test": "pnpm --dir frontend test",
    "typecheck:backend": "cd backend && bun run typecheck",
    "test:backend": "cd backend && bun run test",
    "db:migrate": "cd backend && bun run db:migrate",
    "db:seed:demo": "cd backend && bun run db:seed:demo",
    "db:seed:finance-demo": "cd backend && bun run db:seed:finance-demo",
    "db:seed:year-demo": "cd backend && bun run db:seed:year-demo"
  }
}
