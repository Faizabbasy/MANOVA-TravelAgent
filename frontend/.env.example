# Backend (Elysia) origin that Nuxt proxies /api/v1/** to (server/routes/api/v1), and that SSR calls directly.
# Read at runtime.
NUXT_API_PROXY_TARGET=http://localhost:3000

# Base path the browser calls. Keep the default so requests stay first-party through the Nuxt proxy;
# set an absolute URL only if the API is served from its own origin (then set APP_ORIGINS on the backend).
NUXT_PUBLIC_API_BASE=/api/v1
